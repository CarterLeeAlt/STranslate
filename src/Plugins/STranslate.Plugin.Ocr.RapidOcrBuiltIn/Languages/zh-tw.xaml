<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="STranslate_Plugin_Ocr_RapidOcr">介紹</sys:String>
    <sys:String x:Key="STranslate_Plugin_Ocr_RapidOcr_Content">本外掛使用 RapidOCR（PP-OCRv6 small 模型）在本機離線辨識，支援簡繁中文、日文、英文及常見拉丁字母語言，能處理傾斜、旋轉、倒置與直書文字。模型會在首次辨識時載入。</sys:String>
    <sys:String x:Key="STranslate_Plugin_Ocr_RapidOcr_IdleUnload">閒置釋放模型（分鐘）</sys:String>
    <sys:String x:Key="STranslate_Plugin_Ocr_RapidOcr_IdleUnload_Description">超過此時間未使用時釋放模型以回收記憶體，下次辨識會重新載入；設為 0 表示模型常駐記憶體</sys:String>
    <sys:String x:Key="STranslate_Plugin_Ocr_RapidOcr_Support">支援</sys:String>
    <sys:String x:Key="STranslate_Plugin_Ocr_RapidOcr_Support_Description">此外掛基於下列開源專案與模型，請點擊連結以支持原專案開發者</sys:String>
    <sys:String x:Key="STranslate_Plugin_Ocr_RapidOcr_UseCount">使用次數</sys:String>
    <sys:String x:Key="STranslate_Plugin_Ocr_RapidOcr_UseCount_Format1">已使用</sys:String>
    <sys:String x:Key="STranslate_Plugin_Ocr_RapidOcr_UseCount_Format2">次</sys:String>

</ResourceDictionary>
