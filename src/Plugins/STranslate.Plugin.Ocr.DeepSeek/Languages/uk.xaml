    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="STranslate_Plugin_Ocr_DeepSeek_Thinking">Режим міркування</sys:String>
    <sys:String x:Key="STranslate_Plugin_Ocr_DeepSeek_Thinking_Description">Якщо увімкнено, модель міркує із середньою інтенсивністю перед видачею тексту: точніше на складній верстці, але повільніше й витрачає більше токенів.</sys:String>
    <sys:String x:Key="STranslate_Plugin_Ocr_DeepSeek_NoTextOutput">DeepSeek не розпізнав текст</sys:String>

